# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google reCAPTCHA v3 keys (obtain from https://www.google.com/recaptcha/admin)
# Public site key used by the browser to generate reCAPTCHA v3 tokens:
VITE_RECAPTCHA_SITE_KEY=""
# Private secret key used strictly on the server to verify tokens (never expose to client):
RECAPTCHA_SECRET_KEY=""
# Minimum human score required (0.0 to 1.0, default 0.5):
RECAPTCHA_MIN_SCORE="0.5"

# ---------------------------------------------------------------------------
# Stripe webhook (POST /api/stripe/webhook) -> Corpus premium sync
# Signature secret from the Stripe Dashboard (Developers -> Webhooks -> your
# endpoint -> "Signing secret", whsec_...). It is NOT the API key.
# Placeholders only — real values live in the server's untracked .env.
# ---------------------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=""
# Shared secret for signing the forward to the Corpus internal endpoint
# (hex HMAC-SHA256 over `${X-Corpus-Timestamp}${rawBody}`). Same value as
# CORPUS_PREMIUM_HMAC_SECRET on the Corpus (Hetzner) side.
CORPUS_PREMIUM_HMAC_SECRET=""
# Corpus internal premium endpoint (Hetzner; NPM access list allows only the
# Batleth IP on this DNS-only record). Default kept commented, per the plan:
# CORPUS_PREMIUM_URL="https://corpus-api.cybrnut.com/internal/premium"
CORPUS_PREMIUM_URL=""

# ---------------------------------------------------------------------------
# Guest checkout (POST /api/checkout) — Stripe Checkout Session, subscription
# mode. Uses a RESTRICTED Stripe test-mode key with checkout-session write
# access ONLY (not the full-account secret key). Placeholders only — real
# values live in the server's untracked .env, never in git.
# ---------------------------------------------------------------------------
# Restricted Stripe secret key (sk_test_...), checkout-session write only:
STRIPE_SECRET_KEY=***
# RECURRING price id of the premium plan (price_..., Dashboard -> Products):
STRIPE_PREMIUM_PRICE_ID=***
# Where Stripe sends the browser after the checkout completes / is cancelled.
# Optional — defaults to https://corpuspremium.cybrnut.com/{thank-you,cancel}:
# STRIPE_CHECKOUT_SUCCESS_URL="https://corpuspremium.cybrnut.com/thank-you"
# STRIPE_CHECKOUT_CANCEL_URL="https://corpuspremium.cybrnut.com/cancel"

# ---------------------------------------------------------------------------
# Contact form delivery (POST /api/contact) — nodemailer SMTP. One plain-text
# message per submission to the team inbox; the submitter's address is set as
# Reply-To. STARTTLS on port 587 by default (implicit TLS on 465).
# Placeholders only — real values live in the server's untracked .env, never
# in git. If any REQUIRED key is missing, the form fails closed (no mail is
# sent and the client sees a clear error).
# ---------------------------------------------------------------------------
# SMTP server host (required):
MAIL_SMTP_HOST=""
# SMTP port (optional — defaults to 587/STARTTLS; 465 for implicit TLS):
# MAIL_SMTP_PORT="587"
# SMTP authentication user (required):
MAIL_SMTP_USER=""
# SMTP authentication password (required — never commit real values):
MAIL_SMTP_PASS=""
# Sender address for the outgoing mail, From: header (required):
MAIL_FROM=""
# Team inbox that receives contact submissions (OPTIONAL — when unset,
# enquiries go to MAIL_FROM):
# CONTACT_TO=""

