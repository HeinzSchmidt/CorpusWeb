# Git internals — not needed for the image build
.git
.gitignore

# Node: dependencies are installed inside the image, not shipped from the host
node_modules

# Build outputs are regenerated by stage 1; shipping old ones only hides errors
dist
server.mjs

# Environment files — keep secrets OUT of the build context and the image
.env
.env.local
.env.*.local

# Logs and OS clutter
*.log
npm-debug.log*
.DS_Store

# Documentation / archived material not required at runtime
README.md
archive
